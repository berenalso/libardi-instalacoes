{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/produto/:id",
      "destination": "/produto.html?id=:id",
      "permanent": false
    },
    {
      "source": "/categoria/:categoria",
      "destination": "/catalogo.html?categoria=:categoria",
      "permanent": false
    },
    {
      "source": "/pedidos/:id",
      "destination": "/pedido.html?id=:id",
      "permanent": false
    },
    {
      "source": "/checkout/concluido",
      "destination": "/confirmacao.html",
      "permanent": false
    },
    {
      "source": "/orcamento/concluido",
      "destination": "/orcamento-concluido.html",
      "permanent": false
    },
    {
      "source": "/ofertas",
      "destination": "/catalogo.html?ordem=menor-preco",
      "permanent": false
    },
    {
      "source": "/sobre",
      "destination": "/sobre.html",
      "permanent": false
    },
    {
      "source": "/trocas",
      "destination": "/trocas.html",
      "permanent": false
    },
    {
      "source": "/favoritos",
      "destination": "/favoritos.html",
      "permanent": false
    },
    {
      "source": "/entregas",
      "destination": "/entregas.html",
      "permanent": false
    },
    {
      "source": "/pedido",
      "destination": "/pedido.html",
      "permanent": false
    },
    {
      "source": "/carrinho",
      "destination": "/carrinho.html",
      "permanent": false
    },
    {
